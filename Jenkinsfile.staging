// ============================================================
// Jenkinsfile.staging — LMS Staging Deployment
// Jenkins Docker : 13.38.12.213
// Staging EC2    : 13.38.91.25
// Registry       : AWS ECR (eu-west-3)
// ============================================================

pipeline {
    agent any

    options {
        timeout(time: 90, unit: 'MINUTES')
        timestamps()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    environment {
        // ── AWS ──────────────────────────────────────────────
        AWS_REGION          = 'eu-west-3'
        AWS_ACCOUNT_ID      = credentials('aws-account-id')   // stocker l'ID dans Jenkins
        ECR_REGISTRY        = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_PREFIX          = "${ECR_REGISTRY}/lms"

        // ── Staging EC2 ───────────────────────────────────────
        STAGING_IP          = '13.38.91.25'
        STAGING_USER        = 'ubuntu'

        // ── Versioning ────────────────────────────────────────
        SHORT_SHA           = "${GIT_COMMIT.take(7)}"
        IMAGE_TAG           = "staging-${BUILD_NUMBER}-${SHORT_SHA}"

        // ── Docker Hub (images de base déjà taguées emdy1/*) ──
        DOCKERHUB_USER      = 'emdy1'
    }

    // ── Liste des microservices Spring Boot ──────────────────
    // Chaque entrée : [nom_dossier, nom_image_ecr]
    // Le frontend est traité séparément (contexte différent)
    // ─────────────────────────────────────────────────────────

    stages {

        // ════════════════════════════════════════════════════
        // STAGE 1 — Checkout
        // ════════════════════════════════════════════════════
        stage('🔍 Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_COMMIT_MSG = sh(
                        returnStdout: true,
                        script: 'git log -1 --pretty=%B'
                    ).trim()
                    echo "📌 Commit : ${env.GIT_COMMIT_MSG}"
                    echo "🏷️  Tag    : ${IMAGE_TAG}"
                }
            }
        }

        // ════════════════════════════════════════════════════
        // STAGE 2 — Build Java (Maven) — tous les services en parallèle
        // ════════════════════════════════════════════════════
        stage('🔨 Build Java Services') {
            parallel {
                stage('discovery-server') {
                    steps {
                        dir('lms-microservices/discovery-server') {
                            sh './mvnw clean package -DskipTests -q'
                        }
                    }
                }
                stage('config-server') {
                    steps {
                        dir('lms-microservices/config-server') {
                            sh './mvnw clean package -DskipTests -q'
                        }
                    }
                }
                stage('api-gateway') {
                    steps {
                        dir('lms-microservices/api-gateway') {
                            sh './mvnw clean package -DskipTests -q'
                        }
                    }
                }
                stage('user-service') {
                    steps {
                        dir('lms-microservices/user-service') {
                            sh './mvnw clean package -DskipTests -q'
                        }
                    }
                }
                stage('university-service') {
                    steps {
                        dir('lms-microservices/university-service') {
                            sh './mvnw clean package -DskipTests -q'
                        }
                    }
                }
                stage('course-service') {
                    steps {
                        dir('lms-microservices/course-service') {
                            sh './mvnw clean package -DskipTests -q'
                        }
                    }
                }
                stage('practice-service') {
                    steps {
                        dir('lms-microservices/practice-service') {
                            sh './mvnw clean package -DskipTests -q'
                        }
                    }
                }
                stage('announcement-service') {
                    steps {
                        dir('lms-microservices/announcement-service') {
                            sh './mvnw clean package -DskipTests -q'
                        }
                    }
                }
                stage('ai-service') {
                    steps {
                        dir('lms-microservices/ai-service') {
                            sh './mvnw clean package -DskipTests -q'
                        }
                    }
                }
                stage('meeting-service') {
                    steps {
                        dir('lms-microservices/meeting-service') {
                            sh './mvnw clean package -DskipTests -q'
                        }
                    }
                }
            }
        }

        // ════════════════════════════════════════════════════
        // STAGE 3 — Build React Frontend
        // ════════════════════════════════════════════════════
        stage('⚛️ Build Frontend') {
            steps {
                dir('lms-frontend') {
                    sh '''
                        npm ci --silent
                        REACT_APP_API_URL=http://13.38.91.25:8080 \
                        REACT_APP_ENV=staging \
                        npm run build
                    '''
                }
            }
        }

        // ════════════════════════════════════════════════════
        // STAGE 4 — Login ECR + Build & Push Docker Images
        // ════════════════════════════════════════════════════
        stage('🐳 Docker Build & Push to ECR') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credentials',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    script {
                        // Login ECR
                        sh '''
                            aws ecr get-login-password --region ${AWS_REGION} | \
                            docker login --username AWS --password-stdin ${ECR_REGISTRY}
                        '''

                        // Services Spring Boot
                        def services = [
                            'discovery-server',
                            'config-server',
                            'api-gateway',
                            'user-service',
                            'university-service',
                            'course-service',
                            'practice-service',
                            'announcement-service',
                            'ai-service',
                            'meeting-service'
                        ]

                        services.each { svc ->
                            sh """
                                echo "🐳 Building ${svc}..."
                                docker build \
                                    -t ${ECR_PREFIX}/${svc}:${IMAGE_TAG} \
                                    -t ${ECR_PREFIX}/${svc}:staging-latest \
                                    lms-microservices/${svc}

                                docker push ${ECR_PREFIX}/${svc}:${IMAGE_TAG}
                                docker push ${ECR_PREFIX}/${svc}:staging-latest
                                echo "✅ ${svc} pushed"
                            """
                        }

                        // Frontend (contexte différent)
                        sh """
                            echo "🐳 Building lms-frontend..."
                            docker build \
                                -t ${ECR_PREFIX}/lms-frontend:${IMAGE_TAG} \
                                -t ${ECR_PREFIX}/lms-frontend:staging-latest \
                                lms-frontend

                            docker push ${ECR_PREFIX}/lms-frontend:${IMAGE_TAG}
                            docker push ${ECR_PREFIX}/lms-frontend:staging-latest
                            echo "✅ lms-frontend pushed"
                        """

                        // Nettoyage local des images buildées
                        sh 'docker image prune -f'
                    }
                }
            }
        }

        // ════════════════════════════════════════════════════
        // STAGE 5 — Déploiement sur Staging EC2
        // ════════════════════════════════════════════════════
        stage('🚀 Deploy to Staging') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'staging-ssh-key',
                        keyFileVariable: 'SSH_KEY'
                    ),
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-credentials',
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    ]
                ]) {
                    script {
                        // Générer le docker-compose.staging.yml dynamiquement
                        // et le transférer sur le serveur staging
                        def composeContent = """
services:
  postgres_db:
    container_name: postgres_db
    image: pgvector/pgvector:pg16
    restart: unless-stopped
    environment:
      POSTGRES_USER: \${POSTGRES_USER}
      POSTGRES_PASSWORD: \${POSTGRES_PASSWORD}
      POSTGRES_DB: lmsdb_staging
    volumes:
      - postgres_data_staging:/var/lib/postgresql/data
      - ./postgres-init/init.sql:/docker-entrypoint-initdb.d/init.sql
    networks: [lms-network]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \${POSTGRES_USER} -d lmsdb_staging"]
      interval: 10s
      timeout: 5s
      retries: 5

  kafka:
    image: confluentinc/cp-kafka:7.4.0
    container_name: kafka
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka:9093
      KAFKA_LISTENERS: PLAINTEXT://kafka:29092,CONTROLLER://kafka:9093,PLAINTEXT_HOST://0.0.0.0:9092
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
      KAFKA_INTER_BROKER_LISTENER_NAME: PLAINTEXT
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      CLUSTER_ID: MkU3OEVBNTcwNTJENDM2Qk
    volumes: [kafka_data_staging:/var/lib/kafka/data]
    networks: [lms-network]
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "kafka-broker-api-versions --bootstrap-server localhost:9092 || exit 1"]
      interval: 15s
      timeout: 10s
      retries: 10
      start_period: 30s

  discovery-server:
    image: ${ECR_PREFIX}/discovery-server:${IMAGE_TAG}
    container_name: discovery-server
    ports: ["8761:8761"]
    environment:
      JAVA_OPTS: -Xmx384m -Xms256m
    networks: [lms-network]
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:8761/actuator/health"]
      interval: 15s
      timeout: 10s
      retries: 10
      start_period: 30s

  config-server:
    image: ${ECR_PREFIX}/config-server:${IMAGE_TAG}
    container_name: config-server
    ports: ["8888:8888"]
    environment:
      EUREKA_CLIENT_SERVICEURL_DEFAULTZONE: http://discovery-server:8761/eureka/
      SPRING_PROFILES_ACTIVE: native
      JAVA_OPTS: -Xmx384m -Xms256m
    volumes: [./config-repo:/app/config-repo]
    networks: [lms-network]
    restart: unless-stopped
    depends_on:
      discovery-server: {condition: service_healthy}
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:8888/actuator/health"]
      interval: 15s
      timeout: 10s
      retries: 10
      start_period: 30s

  api-gateway:
    image: ${ECR_PREFIX}/api-gateway:${IMAGE_TAG}
    container_name: api-gateway
    ports: ["8080:8080"]
    environment:
      EUREKA_CLIENT_SERVICEURL_DEFAULTZONE: http://discovery-server:8761/eureka/
      SPRING_CONFIG_IMPORT: configserver:http://config-server:8888
      JWT_SECRET: \${JWT_SECRET}
      BASE_URL: http://13.38.91.25:8080
      FRONTEND_URL: http://13.38.91.25:3000
      JAVA_OPTS: -Xmx512m -Xms256m
    networks: [lms-network]
    restart: unless-stopped
    depends_on:
      discovery-server: {condition: service_healthy}
      config-server: {condition: service_healthy}

  user-service:
    image: ${ECR_PREFIX}/user-service:${IMAGE_TAG}
    container_name: user-service
    ports: ["8081:8081"]
    environment:
      EUREKA_CLIENT_SERVICEURL_DEFAULTZONE: http://discovery-server:8761/eureka/
      SPRING_CONFIG_IMPORT: configserver:http://config-server:8888
      USER_DB_URL: jdbc:postgresql://postgres_db:5432/user_db
      DB_USERNAME: \${DB_USERNAME}
      DB_PASSWORD: \${DB_PASSWORD}
      JWT_SECRET: \${JWT_SECRET}
      KAFKA_BOOTSTRAP_SERVERS: kafka:29092
      JAVA_OPTS: -Xmx512m -Xms256m
    networks: [lms-network]
    restart: unless-stopped
    depends_on:
      config-server: {condition: service_healthy}
      postgres_db: {condition: service_healthy}

  university-service:
    image: ${ECR_PREFIX}/university-service:${IMAGE_TAG}
    container_name: university-service
    ports: ["8082:8082"]
    environment:
      EUREKA_CLIENT_SERVICEURL_DEFAULTZONE: http://discovery-server:8761/eureka/
      SPRING_CONFIG_IMPORT: configserver:http://config-server:8888
      UNIVERSITY_DB_URL: jdbc:postgresql://postgres_db:5432/university_db
      DB_USERNAME: \${DB_USERNAME}
      DB_PASSWORD: \${DB_PASSWORD}
      KAFKA_BOOTSTRAP_SERVERS: kafka:29092
      JAVA_OPTS: -Xmx512m -Xms256m
    networks: [lms-network]
    restart: unless-stopped
    depends_on:
      config-server: {condition: service_healthy}

  course-service:
    image: ${ECR_PREFIX}/course-service:${IMAGE_TAG}
    container_name: course-service
    ports: ["8083:8083"]
    environment:
      EUREKA_CLIENT_SERVICEURL_DEFAULTZONE: http://discovery-server:8761/eureka/
      SPRING_CONFIG_IMPORT: configserver:http://config-server:8888
      COURSE_DB_URL: jdbc:postgresql://postgres_db:5432/course_db
      DB_USERNAME: \${DB_USERNAME}
      DB_PASSWORD: \${DB_PASSWORD}
      KAFKA_BOOTSTRAP_SERVERS: kafka:29092
      BASE_URL: http://13.38.91.25:8080
      FRONTEND_URL: http://13.38.91.25:3000
      JAVA_OPTS: -Xmx512m -Xms256m
    volumes: [uploads_staging:/app/uploads]
    networks: [lms-network]
    restart: unless-stopped
    depends_on:
      config-server: {condition: service_healthy}
      postgres_db: {condition: service_healthy}

  practice-service:
    image: ${ECR_PREFIX}/practice-service:${IMAGE_TAG}
    container_name: practice-service
    ports: ["8084:8084"]
    environment:
      EUREKA_CLIENT_SERVICEURL_DEFAULTZONE: http://discovery-server:8761/eureka/
      SPRING_CONFIG_IMPORT: optional:configserver:http://config-server:8888
      PRACTICE_DB_URL: jdbc:postgresql://postgres_db:5432/practice_db
      DB_USERNAME: \${DB_USERNAME}
      DB_PASSWORD: \${DB_PASSWORD}
      KAFKA_BOOTSTRAP_SERVERS: kafka:29092
      JUDGE0_BASE_URL: http://judge0:2358
      JAVA_OPTS: -Xmx512m -Xms256m
    networks: [lms-network]
    restart: unless-stopped
    depends_on:
      config-server: {condition: service_healthy}
      postgres_db: {condition: service_healthy}

  announcement-service:
    image: ${ECR_PREFIX}/announcement-service:${IMAGE_TAG}
    container_name: announcement-service
    ports: ["8086:8086"]
    environment:
      EUREKA_CLIENT_SERVICEURL_DEFAULTZONE: http://discovery-server:8761/eureka/
      SPRING_CONFIG_IMPORT: configserver:http://config-server:8888
      ANNOUNCEMENT_DB_URL: jdbc:postgresql://postgres_db:5432/announcement_db
      DB_USERNAME: \${DB_USERNAME}
      DB_PASSWORD: \${DB_PASSWORD}
      KAFKA_BOOTSTRAP_SERVERS: kafka:29092
      JAVA_OPTS: -Xmx512m -Xms256m
    networks: [lms-network]
    restart: unless-stopped
    depends_on:
      config-server: {condition: service_healthy}

  ai-service:
    image: ${ECR_PREFIX}/ai-service:${IMAGE_TAG}
    container_name: ai-service
    ports: ["8085:8085"]
    environment:
      EUREKA_CLIENT_SERVICEURL_DEFAULTZONE: http://discovery-server:8761/eureka/
      SPRING_CONFIG_IMPORT: configserver:http://config-server:8888
      AI_DB_URL: jdbc:postgresql://postgres_db:5432/ai_db
      DB_USERNAME: \${DB_USERNAME}
      DB_PASSWORD: \${DB_PASSWORD}
      GROQ_API_KEY: \${GROQ_API_KEY}
      GEMINI_API_KEY: \${GEMINI_API_KEY}
      KAFKA_BOOTSTRAP_SERVERS: kafka:29092
      JAVA_OPTS: -Xmx512m -Xms256m
    networks: [lms-network]
    restart: unless-stopped
    depends_on:
      config-server: {condition: service_healthy}
      postgres_db: {condition: service_healthy}

  meeting-service:
    image: ${ECR_PREFIX}/meeting-service:${IMAGE_TAG}
    container_name: meeting-service
    ports: ["8087:8087"]
    environment:
      EUREKA_CLIENT_SERVICEURL_DEFAULTZONE: http://discovery-server:8761/eureka/
      SPRING_CONFIG_IMPORT: configserver:http://config-server:8888
      MEETING_DB_URL: jdbc:postgresql://postgres_db:5432/meeting_db
      DB_USERNAME: \${DB_USERNAME}
      DB_PASSWORD: \${DB_PASSWORD}
      LIVEKIT_API_KEY: \${LIVEKIT_API_KEY}
      LIVEKIT_API_SECRET: \${LIVEKIT_API_SECRET}
      LIVEKIT_SERVER_URL: ws://livekit:7880
      LIVEKIT_PUBLIC_URL: http://13.38.91.25:7880
      JAVA_OPTS: -Xmx512m -Xms256m
    networks: [lms-network]
    restart: unless-stopped
    depends_on:
      config-server: {condition: service_healthy}
      postgres_db: {condition: service_healthy}

  lms-frontend:
    image: ${ECR_PREFIX}/lms-frontend:${IMAGE_TAG}
    container_name: lms-frontend
    ports: ["3000:80"]
    networks: [lms-network]
    restart: unless-stopped
    depends_on: [api-gateway]

volumes:
  postgres_data_staging:
  kafka_data_staging:
  uploads_staging:

networks:
  lms-network:
    driver: bridge
"""
                        // Écrire le compose dans un fichier temporaire
                        writeFile file: 'docker-compose.staging.generated.yml', text: composeContent

                        // Transférer le fichier sur le serveur staging
                        sh """
                            scp -i \${SSH_KEY} -o StrictHostKeyChecking=no \
                                docker-compose.staging.generated.yml \
                                ${STAGING_USER}@${STAGING_IP}:~/lms/lms-microservices/docker-compose.staging.yml
                        """

                        // Déployer via SSH
                        sh """
                            ssh -i \${SSH_KEY} -o StrictHostKeyChecking=no \
                                ${STAGING_USER}@${STAGING_IP} bash -s << 'REMOTE'

                            set -e
                            cd ~/lms/lms-microservices

                            echo "🔐 Login ECR..."
                            aws ecr get-login-password --region ${AWS_REGION} | \\
                                docker login --username AWS --password-stdin ${ECR_REGISTRY}

                            echo "📥 Pull des nouvelles images..."
                            docker compose -f docker-compose.staging.yml pull

                            echo "🔄 Redémarrage des services..."
                            docker compose -f docker-compose.staging.yml down --remove-orphans || true
                            docker compose -f docker-compose.staging.yml up -d

                            echo "⏳ Attente démarrage (45s)..."
                            sleep 45

                            echo "🧹 Nettoyage images obsolètes..."
                            docker image prune -af

                            echo "✅ Déploiement staging terminé !"
REMOTE
                        """
                    }
                }
            }
        }

        // ════════════════════════════════════════════════════
        // STAGE 6 — Health Checks
        // ════════════════════════════════════════════════════
        stage('🏥 Health Checks') {
            steps {
                script {
                    def checks = [
                        [name: 'Discovery Server', url: "http://${STAGING_IP}:8761/actuator/health"],
                        [name: 'Config Server',    url: "http://${STAGING_IP}:8888/actuator/health"],
                        [name: 'API Gateway',      url: "http://${STAGING_IP}:8080/actuator/health"],
                        [name: 'User Service',     url: "http://${STAGING_IP}:8081/actuator/health"],
                        [name: 'Course Service',   url: "http://${STAGING_IP}:8083/actuator/health"],
                        [name: 'Frontend',         url: "http://${STAGING_IP}:3000"],
                    ]

                    checks.each { check ->
                        def status = sh(
                            returnStatus: true,
                            script: "curl -sf --max-time 10 '${check.url}' > /dev/null"
                        )
                        if (status == 0) {
                            echo "✅ ${check.name} — OK"
                        } else {
                            echo "⚠️  ${check.name} — pas encore prêt (non bloquant)"
                        }
                    }
                }
            }
        }

        // ════════════════════════════════════════════════════
        // STAGE 7 — Smoke Tests
        // ════════════════════════════════════════════════════
        stage('🧪 Smoke Tests') {
            steps {
                sh """
                    echo "🧪 Test frontend accessible..."
                    curl -sf --max-time 15 http://${STAGING_IP}:3000 > /dev/null && \
                        echo "✅ Frontend OK" || echo "⚠️  Frontend non accessible"

                    echo "🧪 Test API Gateway health..."
                    curl -sf --max-time 15 http://${STAGING_IP}:8080/actuator/health > /dev/null && \
                        echo "✅ API Gateway OK" || echo "⚠️  API Gateway non accessible"

                    echo "🧪 Test Eureka dashboard..."
                    curl -sf --max-time 15 http://${STAGING_IP}:8761 > /dev/null && \
                        echo "✅ Eureka OK" || echo "⚠️  Eureka non accessible"
                """
            }
        }

    } // end stages

    // ════════════════════════════════════════════════════
    // POST — Notifications & Cleanup
    // ════════════════════════════════════════════════════
    post {
        success {
            echo """
╔══════════════════════════════════════════════════╗
║  ✅  LMS STAGING DEPLOYMENT SUCCESSFUL           ║
║  Build   : #${BUILD_NUMBER}                      ║
║  Tag     : ${IMAGE_TAG}                          ║
║  URL     : http://13.38.91.25:3000               ║
║  Eureka  : http://13.38.91.25:8761               ║
╚══════════════════════════════════════════════════╝
            """
        }

        failure {
            echo "❌ Déploiement échoué — Build #${BUILD_NUMBER}"
            // Rollback automatique : relancer l'ancienne version
            withCredentials([sshUserPrivateKey(
                credentialsId: 'staging-ssh-key',
                keyFileVariable: 'SSH_KEY'
            )]) {
                sh """
                    echo "🔄 Tentative de rollback..."
                    ssh -i \${SSH_KEY} -o StrictHostKeyChecking=no \
                        ${STAGING_USER}@${STAGING_IP} \
                        'cd ~/lms/lms-microservices && docker compose -f docker-compose.staging.yml up -d' || true
                """
            }
        }

        always {
            // Supprimer le fichier compose temporaire généré
            sh 'rm -f docker-compose.staging.generated.yml || true'
            cleanWs()
        }
    }

} // end pipeline
