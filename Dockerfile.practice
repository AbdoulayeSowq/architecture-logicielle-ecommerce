FROM maven:3.9-eclipse-temurin-17 AS builder

WORKDIR /app

# Copy only the practice-service pom and source
COPY lms-microservices/practice-service /app/practice-service

WORKDIR /app/practice-service

# Build with Maven
RUN mvn clean package -DskipTests=true

# Extract the JAR
FROM openjdk:17-jdk-slim

COPY --from=builder /app/practice-service/target/practice-service-*.jar app.jar

EXPOSE 8084

ENTRYPOINT ["java", "-jar", "app.jar"]
