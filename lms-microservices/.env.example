# ============================================================
# LMS EPT — Variables d'environnement (Docker Compose)
# cp .env.example .env  puis remplir les valeurs
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=lmsuser
POSTGRES_PASSWORD=lmspass
POSTGRES_DB=lmsdb

# --- Credentials partagés par les microservices ---
DB_USERNAME=lmsuser
DB_PASSWORD=lmspass

# --- JWT ---
JWT_SECRET=change_me_to_a_64_char_hex_secret_openssl_rand_hex_32

# --- PgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@lms.com
PGADMIN_DEFAULT_PASSWORD=admin

# --- AI Service ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- MinIO (stockage objet : vidéos, PDF, supports de cours) ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me_to_a_strong_password
MINIO_BUCKET=course-files